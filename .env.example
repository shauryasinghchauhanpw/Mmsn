# ── MMSN Clipper — copy to .env ──────────────────────────────────────────
# No real secrets here. Never commit a filled-in .env.

# Database: SQLite for local dev. Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mmsn
# (a bare postgres:// URL is normalised to postgresql+psycopg:// by
# backend/app/database.py). Same models on both — see ARCHITECTURE.md §5.
#
# FREE options (see FREE_TIER.md / DEPLOYMENT.md):
# - Oracle VM path (docker-compose.yml): Postgres runs in Docker on the
#   VM — DATABASE_URL is set by compose, you do not set it here.
# - Neon free Postgres (no card, no expiry): paste your Neon URL here,
#   e.g. DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/mmsn
#   (0.5 GB storage, 100 CU-hours/mo — plenty for this app).
# - Leave it as SQLite below and the database lives in a local file
#   (lost on Render free restarts — demo only).
DATABASE_URL=sqlite:///./mmsn.db

# Postgres credentials for docker-compose.yml (Oracle VM path only).
# The setup script (scripts/oracle-setup.sh) generates these for you.
# Never commit a real password.
POSTGRES_USER=mmsn
POSTGRES_PASSWORD=
POSTGRES_DB=mmsn

# Public domain of the backend (Oracle VM path only, used by Caddy for
# automatic HTTPS). Example: DOMAIN=clipper.example.com
DOMAIN=

# Local file storage (dev). S3-compatible in production — see below.
UPLOAD_DIR=./uploads
MEDIA_DIR=./media

# ── Storage backend (Phase 3) ────────────────────────────────────────────
# STORAGE_BACKEND=local (default): files under UPLOAD_DIR/MEDIA_DIR.
# STORAGE_BACKEND=s3: S3-compatible object storage (AWS S3, MinIO,
# Cloudflare R2, ...). Uploads/downloads/thumbnails go through
# backend/app/storage.py; downloads are presigned URLs. Leave the S3
# variables blank in local mode — they are ignored unless
# STORAGE_BACKEND=s3. S3_ENDPOINT_URL blank = AWS S3 itself; set it for
# MinIO/R2/etc. (e.g. https://<account-id>.r2.cloudflarestorage.com).
# If S3_ACCESS_KEY/S3_SECRET_KEY are blank, boto3 falls back to its
# default credential chain (environment, ~/.aws, IAM role).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# How long a presigned S3 download URL stays valid (seconds).
S3_PRESIGNED_EXPIRY_SECONDS=3600

# ── Background jobs: Celery + Redis (Phase 3) ────────────────────────────
# CELERY_BROKER_URL unset (default): the in-process ThreadPoolExecutor
# runs jobs — jobs die with the process, as in Phase 1/2.
# Set it to a Redis URL to hand jobs to Celery workers instead:
#   CELERY_BROKER_URL=redis://localhost:6379/0
# then run a worker (repo root):
#   celery -A backend.app.celery_app worker --loglevel=info --concurrency=1
# REDIS_URL is accepted as an alias for CELERY_BROKER_URL.
# CELERY_RESULT_BACKEND defaults to the broker URL; it is optional —
# job state lives in the DB, not in Celery results.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Upload limits
MAX_UPLOAD_MB=2048
MAX_VIDEO_SECONDS=14400

# Transcription: faster-whisper model name.
# tiny (~75 MB) / base (~145 MB) / small (~490 MB) / large-v3-turbo (~1.6 GB)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Clips
CLIPS_PER_PROJECT=3
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60

# ── Optional API keys (leave blank = feature disabled, with a clear message) ──
# YouTube Data API v3 key — link-paste metadata only. Free, quota-capped.
# How to get one: Google Cloud Console → enable YouTube Data API v3 →
# Credentials → API key. See README.md.
YOUTUBE_API_KEY=

# OpenAI-compatible key — LLM highlight scoring. Without it the built-in
# heuristic scorer runs instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Hugging Face token — only needed later for gated diarization weights.
HF_TOKEN=

# CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ── Auth (Phase 2, step 1) ───────────────────────────────────────────────
# JWT secret — REQUIRED. The server refuses to start without a random
# string of at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# and paste it into your local .env (never commit a real secret).
# AUTH_SECRET is accepted as an alias for SECRET_KEY.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# JWT lifetime in seconds. Default 604800 = 7 days. Logout is client-side
# token discard (see README.md) — a discarded token stays valid until it
# expires, so keep this short in production if that matters to you.
AUTH_TOKEN_LIFETIME_SECONDS=604800

# Optional seed/dev account — created on startup ONLY if both are set.
# Local dev/testing only; never set these in production.
SEED_EMAIL=
SEED_PASSWORD=
